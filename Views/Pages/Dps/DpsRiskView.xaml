<UserControl x:Class="TrustNTE.Views.Pages.DpsRiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DpsAnalysisPageResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" MaxWidth="640" VerticalAlignment="Center" Margin="0,0,0,30" Padding="26">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="⚠ " FontSize="16" Foreground="#FF00E5"/>
                <TextBlock Text="风险告知" FontSize="16" FontWeight="Bold" Foreground="#FF00E5"/>
            </StackPanel>
            <TextBlock Text="角色DPS伤害统计,是用Npcap抓包" FontSize="15" FontWeight="Bold" Foreground="#FF3355" Margin="0,0,0,10"/>
            <TextBlock Foreground="#C8CCD8" FontSize="13" LineHeight="22" TextWrapping="Wrap">
                启动后,本工具将 <Run Foreground="#00F0FF" FontWeight="Bold">截获本机与游戏服务器之间的游戏数据包,并解析其中的伤害记录</Run>。该操作涉及网络流量监听,存在被杀毒软件拦截或误报的可能,请确认你了解并自愿承担相关风险。
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                <TextBlock Text="📥 抓包依赖: " FontSize="12" Foreground="#8A8AA0" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" FontSize="12">
                    <Hyperlink NavigateUri="https://npcap.com" RequestNavigate="OnNpcapLink_Click" Foreground="#00F0FF">下载 Npcap(官方地址) ↗</Hyperlink>
                </TextBlock>
                <TextBlock Text="  没有它就没有数据" FontSize="12" Foreground="#00FF9C" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox Content="我已了解风险,并自愿承担一切后果" IsChecked="{Binding AcceptedRisk}" Margin="0,16,0,8" Foreground="#C8CCD8"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="🌐 监听网卡: " FontSize="12" Foreground="#8A8AA0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Width="360"/>
                <Button Content="↻ 刷新" Style="{StaticResource NeoBtn}" Margin="10,0,0,0" Command="{Binding RefreshDevicesCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding CaptureStatusText}" FontSize="11" Foreground="#8A8AA0"
                       TextWrapping="Wrap" MaxHeight="48" Margin="0,12,0,0"/>
            <Button Content="▶ 启动抓包" Margin="0,12,0,0" FontSize="15" Padding="0,12"
                    Style="{StaticResource NeoBtn}" Command="{Binding StartCaptureCommand}"
                    IsEnabled="{Binding AcceptedRisk}"/>
            <TextBlock Text="原始 PCAP 落盘默认关闭 · 数据仅存内存,停止采集即结算" FontSize="10" Foreground="#8A8AA0" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
