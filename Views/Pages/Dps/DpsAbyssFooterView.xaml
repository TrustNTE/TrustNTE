<UserControl x:Class="TrustNTE.Views.Pages.Dps.DpsAbyssFooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DpsShared.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 紧凑竖排:楼层头 + 上/下半两块。无外边距,位置由 DpsLiveView 控制 -->
    <Border Style="{StaticResource Card}" Padding="14,10">
        <StackPanel>
            <!-- 楼层头 -->
            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- TODO: 12F 是 mock;VM 有楼层属性后改绑定 FloorStr -->
                    <TextBlock Text="12F" FontSize="22" FontWeight="Bold" Foreground="#FFE600"
                               FontFamily="Cascadia Mono, Consolas"/>
                    <TextBlock Text="{helpers:Trans '轨外之境'}" FontSize="10" Foreground="#8A8AA0"
                               VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                </StackPanel>
                <TextBlock Text="ABYSS" FontSize="9" Foreground="#66FFE600"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 上半 -->
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{helpers:Trans '▲ 上半'}" FontSize="11" Foreground="#00F0FF"/>
                    <TextBlock Text="{Binding UpperDur}" FontSize="10" Foreground="#8A8AA0"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock Text="{Binding UpperDmg}" FontSize="18" FontWeight="Bold" Foreground="#00F0FF"
                               FontFamily="Cascadia Mono, Consolas"/>
                    <TextBlock Text="{Binding UpperSub}" FontSize="10" Foreground="#8A8AA0"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>

            <Rectangle Height="1" Fill="#2A2A40" Margin="0,0,0,8"/>

            <!-- 下半(待战态压暗) -->
            <Grid Opacity="0.5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{helpers:Trans '▼ 下半'}" FontSize="11" Foreground="#00F0FF"/>
                    <TextBlock Text="{helpers:Trans '待战'}" FontSize="10" Foreground="#8A8AA0"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock Text="—" FontSize="18" FontWeight="Bold" Foreground="#8A8AA0"
                               FontFamily="Cascadia Mono, Consolas"/>
                    <TextBlock Text="{helpers:Trans '等待换半标记'}" FontSize="10" Foreground="#8A8AA0"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
