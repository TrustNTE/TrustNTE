<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <DrawingBrush x:Key="GridPat" TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Thickness="1" Brush="#0D00F0FF"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,48,48"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="NeoBtn" TargetType="Button">
        <Setter Property="Background" Value="#1400F0FF"/>
        <Setter Property="Foreground" Value="#00F0FF"/>
        <Setter Property="BorderBrush" Value="#4D00F0FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2800F0FF"/>
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00F0FF" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeoBtnDanger" TargetType="Button" BasedOn="{StaticResource NeoBtn}">
        <Setter Property="Background" Value="#14FF00E5"/>
        <Setter Property="Foreground" Value="#FF00E5"/>
        <Setter Property="BorderBrush" Value="#66FF00E5"/>
    </Style>

    <Style x:Key="NeoToggleBase" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#00F0FF"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="#1400F0FF" BorderBrush="#4D00F0FF" BorderThickness="1"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2800F0FF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3300F0FF"/>
                            <Setter Property="Foreground" Value="#00FF9C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NeoRadio" TargetType="RadioButton" BasedOn="{StaticResource NeoToggleBase}"/>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="#12121F"/>
        <Setter Property="BorderBrush" Value="#4D00F0FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="KpiNum" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="SecTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#8A8AA0"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="AttrRing" TargetType="Border">
        <Setter Property="BorderBrush" Value="#667788"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="21"/>
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Attribute}" Value="相">
                <Setter Property="BorderBrush" Value="#FF66B3"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="灵">
                <Setter Property="BorderBrush" Value="#00F0FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="光">
                <Setter Property="BorderBrush" Value="#FFE600"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="暗">
                <Setter Property="BorderBrush" Value="#FF4D6D"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="咒">
                <Setter Property="BorderBrush" Value="#B266FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="魂">
                <Setter Property="BorderBrush" Value="#9EFF6E"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AttrText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#99AABB"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Attribute}" Value="相">
                <Setter Property="Foreground" Value="#FF66B3"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="灵">
                <Setter Property="Foreground" Value="#00F0FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="光">
                <Setter Property="Foreground" Value="#FFE600"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="暗">
                <Setter Property="Foreground" Value="#FF4D6D"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="咒">
                <Setter Property="Foreground" Value="#B266FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="魂">
                <Setter Property="Foreground" Value="#9EFF6E"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AttrFill" TargetType="Rectangle">
        <Setter Property="Fill" Value="#667788"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Attribute}" Value="相">
                <Setter Property="Fill" Value="#FF66B3"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="灵">
                <Setter Property="Fill" Value="#00F0FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="光">
                <Setter Property="Fill" Value="#FFE600"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="暗">
                <Setter Property="Fill" Value="#FF4D6D"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="咒">
                <Setter Property="Fill" Value="#B266FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Attribute}" Value="魂">
                <Setter Property="Fill" Value="#9EFF6E"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 头像:有图显图,无图显属性色首字 -->
    <DataTemplate x:Key="AvatarTpl">
        <Grid>
            <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource AttrText}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <!-- 角色行(点击进详情) -->
    <DataTemplate x:Key="CharRowTpl">
        <Border CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Cursor="Hand">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick"
                              Command="{Binding DataContext.OpenCharacterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"/>
            </Border.InputBindings>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#161628"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1E1E30"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource AttrRing}" ClipToBounds="True">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarTpl}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#E8E8F0"/>
                        <Border Background="#0F0F1A" BorderThickness="1" BorderBrush="#2A2A40" CornerRadius="2" Margin="8,0,0,0" Padding="5,0">
                            <TextBlock Text="{Binding Attribute}" FontSize="9" Style="{StaticResource AttrText}"/>
                        </Border>
                    </StackPanel>
                    <Border Height="6" Background="#1E1E30" CornerRadius="3" Margin="0,7,0,0">
                        <Rectangle Style="{StaticResource AttrFill}" HorizontalAlignment="Left"
                                   Width="{Binding BarWidth}" RadiusX="3" RadiusY="3"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DamageStr}" FontSize="14" FontWeight="Bold" Foreground="#FFE600"
                               HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas"/>
                    <TextBlock Text="{Binding DpsStr}" FontSize="10" Foreground="#8A8AA0" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding ShareStr}" FontSize="10" Foreground="#8A8AA0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 技能行 -->
    <DataTemplate x:Key="SkillRowTpl">
        <Border Background="#161628" CornerRadius="4" Padding="10,8" Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Style="{StaticResource AttrFill}" Width="8" Height="8" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SkillName}" FontSize="12" Foreground="#C8CCD8"
                           Margin="10,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#14FF00E5" BorderBrush="#66FF00E5" BorderThickness="1" CornerRadius="2" Padding="4,0" Margin="0,0,8,0"
                            Visibility="{Binding IsFollowUp, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="FU" FontSize="8" Foreground="#FF00E5"/>
                    </Border>
                    <Border Width="130" Height="5" Background="#1E1E30" CornerRadius="2" VerticalAlignment="Center">
                        <Rectangle Fill="#FFE600" HorizontalAlignment="Left" Width="{Binding BarWidth}" RadiusX="2" RadiusY="2"/>
                    </Border>
                    <TextBlock Text="{Binding PctStr}" FontSize="11" Foreground="#FFE600" Width="46" TextAlignment="Right" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding DamageStr}" FontSize="10" Foreground="#8A8AA0" Width="78" TextAlignment="Right" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 时间线桶 -->
    <DataTemplate x:Key="BucketTpl">
        <Rectangle Width="7" Height="{Binding HeightPct}" Margin="0,0,1,0" VerticalAlignment="Bottom">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Fill" Value="#00F0FF"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="tstop">
                            <Setter Property="Fill" Value="#3A3F4C"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="marker">
                            <Setter Property="Fill" Value="#FF00E5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>
    </DataTemplate>

    <!-- 质量 chip -->
    <DataTemplate x:Key="ChipTpl">
        <Border CornerRadius="2" Padding="8,4" Margin="0,0,8,6" Background="#161628" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#2A2A40"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarn}" Value="True">
                            <Setter Property="BorderBrush" Value="#66FFE600"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#8A8AA0"/>
                <TextBlock Text="{Binding ValueStr}" FontSize="10" Margin="6,0,0,0" FontFamily="Cascadia Mono, Consolas">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#00FF9C"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                    <Setter Property="Foreground" Value="#FFE600"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
