<UserControl x:Class="TrustNTE.Views.Pages.GachaAnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="GcBg" Color="#0A0A12"/>
        <SolidColorBrush x:Key="GcCard" Color="#12121F"/>
        <SolidColorBrush x:Key="GcCard2" Color="#161628"/>
        <SolidColorBrush x:Key="GcCyan" Color="#00F0FF"/>
        <SolidColorBrush x:Key="GcMagenta" Color="#FF00E5"/>
        <SolidColorBrush x:Key="GcYellow" Color="#FFE600"/>
        <SolidColorBrush x:Key="GcGreen" Color="#00FF9C"/>
        <SolidColorBrush x:Key="GcGold" Color="#FFD700"/>
        <SolidColorBrush x:Key="GcPurple" Color="#B45FFF"/>

        <SolidColorBrush x:Key="GcText" Color="#E8E8F0"/>
        <SolidColorBrush x:Key="GcDim" Color="#8A8AA0"/>
        <SolidColorBrush x:Key="GcCyanBorder" Color="#4D00F0FF"/>

        <Style x:Key="NeoCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GcCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GcCyanBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="NeoBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource GcCyan}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#1400F0FF" BorderBrush="{StaticResource GcCyanBorder}"
                                BorderThickness="1" CornerRadius="3" Padding="22,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2E00F0FF"/>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F0FF" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter TargetName="bg" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeoBtnDanger" TargetType="Button" BasedOn="{StaticResource NeoBtn}">
            <Setter Property="Foreground" Value="{StaticResource GcMagenta}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#14FF00E5" BorderBrush="#80FF00E5"
                                BorderThickness="1" CornerRadius="3" Padding="22,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2EFF00E5"/>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF00E5" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource GcDim}"/>
        </Style>

        <Style x:Key="CounterNum" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource GcCyan}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00F0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡池汇总卡（可点选，选中亮黄边） -->
        <Style x:Key="PoolCardBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource GcCard}" BorderBrush="#3300F0FF"
                                BorderThickness="1" CornerRadius="4" Padding="16,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CCFFE600"/>
                                <Setter TargetName="bd" Property="Background" Value="#1CFFE600"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeoBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFE600" Offset="0"/>
                        <GradientStop Color="#FFA500" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource GcBg}">
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0.5 L48,0.5 M0.5,0 L0.5,48">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#1400F0FF" Thickness="1"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle Canvas.Left="0" Height="3" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0000F0FF" Offset="0"/>
                        <GradientStop Color="#AA00F0FF" Offset="0.5"/>
                        <GradientStop Color="#0000F0FF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ScanTf" Y="-10"/>
                </Rectangle.RenderTransform>
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="ScanTf" Storyboard.TargetProperty="Y"
                                                 From="-10" To="900" Duration="0:0:7"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>
        </Canvas>

        <Grid Margin="20,14,20,14">
            <!-- ══════════ 风险提示层 ══════════ -->
            <Grid Visibility="{Binding IsRiskLayerVisible, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource NeoCard}" MaxWidth="720" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Padding="28">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="⚠" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource GcMagenta}"/>
                            <TextBlock Text="{helpers:Trans '风险告知'}" FontSize="17" VerticalAlignment="Center"
                                       Foreground="{StaticResource GcMagenta}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF00E5" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Foreground="#C8CCD8" FontSize="14" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="{helpers:Trans '抽卡记录不在本地文件中。'}" Foreground="{StaticResource GcYellow}" FontWeight="Bold"/><LineBreak/>
                            <Run Text="{helpers:Trans '启动后，本工具将'}"/>
                            <Run Text="{helpers:Trans '截获本机与游戏服务器之间的游戏数据包，并解析其中的抽卡记录'}"
                                 Foreground="{StaticResource GcCyan}" FontWeight="Bold"/>
                            <Run Text="{helpers:Trans '。该操作涉及网络流量监听，存在被杀毒软件拦截或误报的可能，请确认你了解并自愿承担相关风险。'}"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="{helpers:Trans '📥 抓包依赖：'}" FontSize="14" Foreground="#C8CCD8" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://npcap.com/#download"
                                           RequestNavigate="OnNpcapLink_Click"
                                           Foreground="{StaticResource GcCyan}" TextDecorations="Underline">
                                    <Run Text="{helpers:Trans '下载 Npcap（官方地址）↗'}"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{helpers:Trans 'Windows 10 2004+ 通常已内置 pktmon 引擎，无需下载即可尝试启动——工具会自动选择可用后端。'}"
                                   FontSize="12" Foreground="{StaticResource GcDim}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <CheckBox Content="{helpers:Trans '我已了解风险，并自愿承担一切后果'}" IsChecked="{Binding IsRiskAccepted}"
                                  Foreground="#C8CCD8" FontSize="13.5" Margin="0,22,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="{helpers:Trans '🌐 监听网卡：'}" FontSize="14" Foreground="#C8CCD8" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding NicOptions}" SelectedItem="{Binding SelectedNic}"
                                      Width="340" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                                      Foreground="#E8E8F0">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#12121F"/>
                                        <Setter Property="Foreground" Value="#E8E8F0"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button Content="{helpers:Trans '↻ 刷新'}" Style="{StaticResource NeoBtn}" Padding="12,6"
                                    Margin="8,0,0,0" Command="{Binding RefreshNicsCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NicStatusText}" FontSize="11.5" Foreground="{StaticResource GcDim}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <Button Content="{helpers:Trans '▶  启动抓包'}" Style="{StaticResource NeoBtn}" Margin="0,18,0,0"
                                IsEnabled="{Binding IsRiskAccepted}" Command="{Binding StartCaptureCommand}"/>

                        <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" FontSize="12"
                                   Foreground="{StaticResource GcYellow}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════ 抓包工作层 ══════════ -->
            <Grid Visibility="{Binding IsWorkLayerVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 状态行 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Border HorizontalAlignment="Left" CornerRadius="3" BorderThickness="1"
                            Padding="12,5" Background="#0D00FF9C" BorderBrush="#6600FF9C">
                        <TextBlock Text="{Binding EngineTag}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   Foreground="{StaticResource GcGreen}"/>
                    </Border>
                    <TextBlock Text="{Binding ElapsedText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{StaticResource GcDim}"/>
                </Grid>

                <!-- 计数器 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource NeoCard}" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{helpers:Trans '捕获包'}" Style="{StaticResource HudLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding CapturedPackets}" Style="{StaticResource CounterNum}" FontSize="24"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource NeoCard}" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{helpers:Trans '解码包'}" Style="{StaticResource HudLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding DecodedPackets}" Style="{StaticResource CounterNum}" FontSize="24"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource NeoCard}" Padding="14,8" BorderBrush="#66FFE600">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{helpers:Trans '抽卡记录'}" Style="{StaticResource HudLabel}" VerticalAlignment="Center"
                                       Foreground="{StaticResource GcYellow}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding RecordCount}" Style="{StaticResource CounterNum}" FontSize="24"
                                       Foreground="{StaticResource GcYellow}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FFE600" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 卡池汇总（对标参考图顶部：总抽数/出卡数/S级平均） -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PoolCardBtn}" DataContext="{Binding PoolSummaries[0]}"
                            Command="{Binding DataContext.SelectPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <TextBlock Text="{Binding TotalPulls}" FontFamily="Cascadia Mono, Consolas" FontSize="26"
                                           FontWeight="Bold" Foreground="{StaticResource GcYellow}"/>
                                <TextBlock Text="{helpers:Trans ' 抽'}" FontSize="12" Foreground="{StaticResource GcDim}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{helpers:Trans '出卡数 '}" FontSize="11" Foreground="{StaticResource GcDim}"/>
                                <TextBlock Text="{Binding FiveStars}" FontSize="11" Foreground="{StaticResource GcCyan}" FontFamily="Cascadia Mono, Consolas"/>
                                <TextBlock Text="{helpers:Trans '   S级平均 '}" FontSize="11" Foreground="{StaticResource GcDim}"/>
                                <TextBlock Text="{Binding AvgPerFive}" FontSize="11" Foreground="{StaticResource GcCyan}" FontFamily="Cascadia Mono, Consolas"/>
                            </StackPanel>
                            <TextBlock FontSize="10" Foreground="{StaticResource GcDim}" Margin="0,3,0,0">
                                <Run Text="{Binding HardPity}"/>
                                <Run Text="{helpers:Trans ' 抽保底'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PoolCardBtn}" DataContext="{Binding PoolSummaries[1]}"
                            Command="{Binding DataContext.SelectPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <TextBlock Text="{Binding TotalPulls}" FontFamily="Cascadia Mono, Consolas" FontSize="26"
                                           FontWeight="Bold" Foreground="{StaticResource GcYellow}"/>
                                <TextBlock Text="{helpers:Trans ' 抽'}" FontSize="12" Foreground="{StaticResource GcDim}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{helpers:Trans '出卡数 '}" FontSize="11" Foreground="{StaticResource GcDim}"/>
                                <TextBlock Text="{Binding FiveStars}" FontSize="11" Foreground="{StaticResource GcCyan}" FontFamily="Cascadia Mono, Consolas"/>
                                <TextBlock Text="{helpers:Trans '   S级平均 '}" FontSize="11" Foreground="{StaticResource GcDim}"/>
                                <TextBlock Text="{Binding AvgPerFive}" FontSize="11" Foreground="{StaticResource GcCyan}" FontFamily="Cascadia Mono, Consolas"/>
                            </StackPanel>
                            <TextBlock FontSize="10" Foreground="{StaticResource GcDim}" Margin="0,3,0,0">
                                <Run Text="{Binding HardPity}"/>
                                <Run Text="{helpers:Trans ' 抽保底'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource PoolCardBtn}" DataContext="{Binding PoolSummaries[2]}"
                            Command="{Binding DataContext.SelectPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <TextBlock Text="{Binding TotalPulls}" FontFamily="Cascadia Mono, Consolas" FontSize="26"
                                           FontWeight="Bold" Foreground="{StaticResource GcYellow}"/>
                                <TextBlock Text="{helpers:Trans ' 抽'}" FontSize="12" Foreground="{StaticResource GcDim}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{helpers:Trans '出卡数 '}" FontSize="11" Foreground="{StaticResource GcDim}"/>
                                <TextBlock Text="{Binding FiveStars}" FontSize="11" Foreground="{StaticResource GcCyan}" FontFamily="Cascadia Mono, Consolas"/>
                                <TextBlock Text="{helpers:Trans '   S级平均 '}" FontSize="11" Foreground="{StaticResource GcDim}"/>
                                <TextBlock Text="{Binding AvgPerFive}" FontSize="11" Foreground="{StaticResource GcCyan}" FontFamily="Cascadia Mono, Consolas"/>
                            </StackPanel>
                            <TextBlock FontSize="10" Foreground="{StaticResource GcDim}" Margin="0,3,0,0">
                                <Run Text="{Binding HardPity}"/>
                                <Run Text="{helpers:Trans ' 抽保底'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 记录流 + S级出货 + 操作 -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- 实时记录流 -->
                    <Border Grid.Column="0" Style="{StaticResource NeoCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource GcCyanBorder}" BorderThickness="0,0,0,1"
                                    Background="{StaticResource GcCard2}" Padding="16,10">
                                <TextBlock Text="{helpers:Trans '实时记录流'}" Style="{StaticResource HudLabel}" Foreground="{StaticResource GcCyan}"/>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Records}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeight="30" Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                      Foreground="#C8CCD8" FontSize="12.5">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource GcDim}"/>
                                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="14,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="14,0" Background="Transparent">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{helpers:Trans '时间'}" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="110"/>
                                    <DataGridTextColumn Header="{helpers:Trans '卡池'}" Binding="{Binding PoolName}" Width="140"/>
                                    <DataGridTemplateColumn Header="{helpers:Trans '物品'}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{Binding AvatarPath}" Width="26" Height="26" Margin="0,0,8,0"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#C8CCD8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Rarity}" Value="5">
                                                                        <Setter Property="Foreground" Value="{StaticResource GcGold}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rarity}" Value="4">
                                                                        <Setter Property="Foreground" Value="{StaticResource GcPurple}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{helpers:Trans '星级'}" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Rarity, StringFormat={}{0}★}" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource GcCyan}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="5">
                                                                    <Setter Property="Foreground" Value="{StaticResource GcGold}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rarity}" Value="4">
                                                                    <Setter Property="Foreground" Value="{StaticResource GcPurple}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{helpers:Trans '数量'}" Binding="{Binding Count}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- 右栏：S级出货 + 操作 -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource NeoCard}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{helpers:Trans 'S级出货一览'}" Style="{StaticResource HudLabel}" Foreground="{StaticResource GcYellow}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource GcDim}" Margin="0,3,0,0">
                                        <Run Text="{helpers:Trans '当前池：'}"/>
                                        <Run Text="{Binding SelectedPool.Name}"/>
                                    </TextBlock>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding SRankDrops}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource GcCard2}" CornerRadius="3"
                                                            Padding="10,8" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <!-- 圆头像（本地 Assets\Avatars\，无图显示底色） -->
                                                                    <Border Width="34" Height="34" CornerRadius="17"
                                                                            BorderBrush="#4D00F0FF" BorderThickness="1"
                                                                            Background="#1AFFFFFF" ClipToBounds="True"
                                                                            VerticalAlignment="Center">
                                                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding DateText}" FontFamily="Cascadia Mono, Consolas"
                                                                               FontSize="12" Foreground="{StaticResource GcDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                    <TextBlock Text="{Binding ItemName}" FontSize="12.5" Foreground="{StaticResource GcGold}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <!-- 「超非」标签：仅 danger 档显示（参考图视觉复刻） -->
                                                                    <Border CornerRadius="3" Background="#CC14141F" BorderBrush="#66FF4444"
                                                                            Padding="6,2" Margin="0,0,8,0"
                                                                            Visibility="{Binding IsDanger, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{helpers:Trans '超非'}" FontSize="10" FontWeight="Bold" Foreground="#FF6B6B"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Pulls}" FontFamily="Cascadia Mono, Consolas"
                                                                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource GcYellow}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{helpers:Trans ' 抽'}" FontSize="11" Foreground="{StaticResource GcDim}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <!-- 进度条按欧非档位变色：good 黄橙 / warn 深橙 / danger 红 -->
                                                            <ProgressBar Maximum="{Binding HardPity}" Value="{Binding Pulls}"
                                                                         Height="8" BorderThickness="0" Background="#22FFFFFF" Margin="0,7,0,0">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource NeoBar}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PityTone}" Value="warn">
                                                                                <Setter Property="Foreground">
                                                                                    <Setter.Value>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                            <GradientStop Color="#FFA500" Offset="0"/>
                                                                                            <GradientStop Color="#FF6600" Offset="1"/>
                                                                                        </LinearGradientBrush>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PityTone}" Value="danger">
                                                                                <Setter Property="Foreground">
                                                                                    <Setter.Value>
                                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                            <GradientStop Color="#FF3366" Offset="0"/>
                                                                                            <GradientStop Color="#CC0000" Offset="1"/>
                                                                                        </LinearGradientBrush>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{helpers:Trans '暂无数据 · 启动抓包后自动汇总'}" FontSize="11.5" Foreground="{StaticResource GcDim}"
                                                   HorizontalAlignment="Center" Margin="0,10,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SRankDrops.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Button Content="{helpers:Trans '⤓  导出 JSON'}" Style="{StaticResource NeoBtn}" Margin="0,0,0,10"
                                Foreground="{StaticResource GcYellow}" Command="{Binding ExportJsonCommand}"/>
                        <Button Content="{helpers:Trans '■  停止抓包'}" Style="{StaticResource NeoBtnDanger}"
                                Command="{Binding StopCaptureCommand}"/>
                        <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" FontSize="11.5"
                                   Foreground="{StaticResource GcYellow}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
