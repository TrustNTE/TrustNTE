<UserControl x:Class="TrustNTE.Views.Pages.Components.OcrTestCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">

    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon TextBulletListSquare24}" IsExpanded="False">
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '文字 OCR 测试'}" />
                    <ui:TextBlock FontTypography="Caption"
                                  Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{helpers:Trans 'ONNX rec-only 引擎 · 识别游戏内文字'}" />
                </StackPanel>

                <ui:HyperlinkButton Grid.Column="1" Content="{helpers:Trans '文档'}"
                                    Command="{Binding ShowOcrDocsCommand}"
                                    Icon="{ui:SymbolIcon BookQuestionMark24}"
                                    Margin="0,0,24,0" VerticalAlignment="Center" />
            </Grid>
        </ui:CardExpander.Header>

        <StackPanel Margin="16,8">

            <!-- 测试按钮区 -->
            <WrapPanel Margin="0,0,0,15" VerticalAlignment="Center">
                <ui:Button Content="{helpers:Trans 'UID 区域识别'}"
                           Command="{Binding TestUidOcrCommand}"
                           Width="110" Margin="0,0,15,0" />
                <!-- 驾驶F 全链路测试（OCR→后台按键），测完删除此按钮 -->
                <ui:Button Content="{helpers:Trans '驾驶F 链路测试'}"
                           Command="{Binding TestDriveFCommand}"
                           Width="110" Margin="0,0,15,0" />
                <ui:TextBlock Text="{helpers:Trans 'UID: 3,1051 (193x27)&#10;驾驶: 1139,547 (133x80) · 角色需站在载具旁'}"
                              VerticalAlignment="Center" TextWrapping="Wrap"
                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            </WrapPanel>

            <Separator Margin="0,0,0,15" BorderThickness="0,1,0,0" />

            <!-- rec 模型路径 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Text="{helpers:Trans 'rec 模型路径：'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ui:TextBox Grid.Column="1"
                            Text="{Binding RecModelPath, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            IsReadOnly="True" PlaceholderText="{helpers:Trans '未找到 rec.onnx'}" />
                <ui:Button Grid.Column="2" Content="{helpers:Trans '打开目录'}"
                           Command="{Binding OpenModelFolderCommand}"
                           CommandParameter="{Binding RecModelPath}"
                           VerticalAlignment="Center"/>
            </Grid>

            <ui:TextBlock Text="{helpers:Trans '提示：引擎为 rec-only 模式（字典内嵌于 rec.onnx），无需 det 模型。每次测试的截图存于 Data\OcrTest 目录，可用于核对 ROI 是否截准。'}"
                          TextWrapping="Wrap" FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

        </StackPanel>
    </ui:CardExpander>
</UserControl>
