<UserControl x:Class="TrustNTE.Views.Pages.Components.AutoDialogueControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon Chat24}" IsExpanded="False">
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '自动剧情'}" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:Trans '快速跳过剧情文本、自动选择选项、自动提交物品等'}" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Margin="0,0,24,0" IsChecked="{Binding Config.AutoDialogueEnabled}" VerticalAlignment="Center" />
            </Grid>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

            <!-- 剧情今日不再提示 -->
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Body" Text="自动点击「今日不再提示」" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="剧情中弹出该提示时自动点击关闭" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoPlotDoNotPromptEnabled}" VerticalAlignment="Center" />
            </Grid>

            <!--环期赠礼签到 -->
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Body" Text="自动领取「环期赠礼签到」" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="识别到签到按钮时自动领取" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoCheckInClaimEnabled}" VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Body" Text="当识别到传送是否传送" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="如果UI中是传送就识别并点击，不是就不识别 " />
                </StackPanel>
                <!-- 自动对话优先选择选项 -->
                <ui:ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoTeleportEnabled}" VerticalAlignment="Center" />
            </Grid>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Body" Text="自动对话优先选择选项" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="进入对话后，对话选项的选择方式" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="180" Margin="0,0,36,0" ItemsSource="{Binding OptionStrategies}" SelectedItem="{Binding Config.AutoDialogueOptionStrategy}" />
            </Grid>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Body" Text="日志输出模式" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="单项输出更紧凑；双线输出分两行（适合排查 Bug）" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="180" Margin="0,0,36,0" ItemsSource="{Binding LogOutputModes}" SelectedItem="{Binding Config.AutoStoryLogMode}" />
            </Grid>
        </StackPanel>
    </ui:CardExpander>
</UserControl>