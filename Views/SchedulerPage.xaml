<UserControl x:Class="TrustNTE.Views.Pages.SchedulerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：配置分组（卡片容器） -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="配置分组" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ListBox x:Name="GroupsList"
                         ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                         DisplayMemberPath="Name" Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="GroupsList_MouseDoubleClick"/>
            </Border>
            <ui:Button Grid.Row="2" Content="新建分组" Command="{Binding AddGroupCommand}"
                       HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
            <ui:Button Grid.Row="3" Content="删除当前组" Command="{Binding DeleteGroupCommand}"
                       CommandParameter="{Binding SelectedGroup}"
                       HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
        </Grid>

        <!-- 右：任务详情 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,10"
                       Text="{Binding SelectedGroup.Name, StringFormat='配置组 - {0}', FallbackValue='配置组'}"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox Width="220" ItemsSource="{Binding AvailableScripts}"
                          SelectedItem="{Binding PickedScript}"/>
                <ui:Button Content="添加为任务" Command="{Binding AddScriptTaskCommand}" Margin="8,0,0,0"/>
                <ui:Button Content="🔄 刷新" Command="{Binding RefreshScriptsCommand}" Margin="8,0,0,0"/>
                <ui:Button Content="📖 文档" Command="{Binding OpenDocCommand}" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 任务列表：卡片容器（细边框 + 主题微底色），内容透明，不再是大白块也不裸奔 -->
            <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ListView ItemsSource="{Binding TaskRows}" SelectionMode="Single"
                          Background="Transparent" BorderThickness="0" Padding="8,4">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="160"/>
                            <GridViewColumn Header="类型" DisplayMemberBinding="{Binding Type}" Width="80"/>
                            <GridViewColumn Header="次数" DisplayMemberBinding="{Binding RunNum}" Width="55"/>
                            <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="110"/>
                            <GridViewColumn Header="操作" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="移除"
                                                   Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                   CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <TextBlock Text="{Binding RunStatusText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <ui:Button Content="▶ 运行当前组" Command="{Binding RunGroupCommand}" Appearance="Primary" Margin="0,0,8,0"/>
                <ui:Button Content="⏩ 连续执行全部" Command="{Binding RunAllCommand}" Margin="0,0,8,0"/>
                <ui:Button Content="⤼ 跳过当前任务" Command="{Binding SkipCurrentCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,8,0"/>
                <ui:Button Content="⏹ 停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
