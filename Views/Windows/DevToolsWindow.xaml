<ui:FluentWindow x:Class="TrustNTE.Views.DevToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:TrustNTE.Helpers"
        Title="{helpers:Trans '开发者工具 · TrustNTE 工具箱'}"
        Height="640" Width="1080" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{helpers:Trans '开发者工具 · TrustNTE 工具箱'}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/titlelogo.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="1" Margin="16,4,16,8" VerticalAlignment="Center">
            <ui:Button Content="{helpers:Trans '抓取画面'}" Command="{Binding GrabOnceCommand}"
                       Appearance="Primary" Margin="0,0,14,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="{helpers:Trans '冻结取色'}" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                <ui:ToggleSwitch IsChecked="{Binding IsFrozen}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="{helpers:Trans '实时预览'}" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                <ui:ToggleSwitch IsChecked="{Binding IsLive}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="{helpers:Trans '预览间隔(ms)'}" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                <Slider Minimum="50" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True"
                        Width="130" VerticalAlignment="Center" Value="{Binding PreviewIntervalMs}"/>
                <TextBlock Text="{Binding PreviewIntervalMs, StringFormat={}{0}ms}" VerticalAlignment="Center"
                           Margin="6,0,0,0" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="{helpers:Trans '放大镜'}" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                <ui:ToggleSwitch IsChecked="{Binding MagnifierOn}"/>
            </StackPanel>
            <ui:Button Content="{helpers:Trans '保存图像'}" Command="{Binding SaveImageCommand}" Margin="0,0,8,0"/>
            <ui:Button Content="{helpers:Trans '打开目录'}" Command="{Binding OpenImageDirCommand}" Margin="0,0,8,0"/>

            <ui:Button Content="{helpers:Trans '清空取色'}" Command="{Binding ClearPicksCommand}"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="260"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
        </WrapPanel>

        <!-- 主体:左=实时预览 | 右=页签面板 -->
        <Grid Grid.Row="2" Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- 画面区:Image/Canvas 尺寸由代码精确设定=画面显示尺寸,黑边在控件外 -->
            <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                    Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}">
                <Grid x:Name="FrameHost" Background="Transparent" Cursor="Cross"
                      MouseMove="FrameHost_MouseMove" MouseLeave="FrameHost_MouseLeave"
                      MouseLeftButtonDown="FrameHost_Click"
                      MouseLeftButtonUp="FrameHost_MouseUp"
                      SizeChanged="FrameHost_SizeChanged">
                    <Image x:Name="FrameImageCtl" Source="{Binding FrameImage}" Stretch="Fill"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="CrossCanvas" IsHitTestVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Line x:Name="CrossV" Stroke="#00E000" StrokeThickness="1" Visibility="Collapsed"/>
                        <Line x:Name="CrossH" Stroke="#00E000" StrokeThickness="1" Visibility="Collapsed"/>
                        <Rectangle x:Name="SelRect" Stroke="#00E000" StrokeThickness="1"
                                   StrokeDashArray="4 2" Visibility="Collapsed"/>
                    </Canvas>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FrameImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{helpers:Trans '画面未就绪'}"/><LineBreak/>
                        <Run Text="{helpers:Trans '请先在【启动】页开启截图引擎,或点击【抓取画面】'}" FontSize="12"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 右栏页签 -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="{helpers:Trans '取色器'}" GroupName="dtTab" Margin="0,0,8,0" MinWidth="100"
                                 IsChecked="{Binding IsColorPickerTab}"/>
                    <RadioButton Content="{helpers:Trans '截图器'}" GroupName="dtTab" MinWidth="100"
                                 IsChecked="{Binding IsEditorTab}"/>
                </StackPanel>

                <!-- ── 取色器页 ── -->
                <Grid Grid.Row="1" Visibility="{Binding IsColorPickerTab, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Picks}" SelectedItem="{Binding SelectedPick}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserSortColumns="False"
                              SelectionMode="Single" HeadersVisibility="Column" RowHeight="30"
                              GridLinesVisibility="Horizontal" Background="Transparent" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="{helpers:Trans '启用'}" Width="40"
                                                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="26"/>
                            <DataGridTemplateColumn Header="{helpers:Trans '色块'}" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="{Binding Swatch}"
                                                BorderThickness="1"
                                                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{helpers:Trans '坐标'}" Binding="{Binding Logical}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="RGB" Binding="{Binding RgbHex}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="HSV" Binding="{Binding HsvText}" IsReadOnly="True" Width="64"/>
                            <DataGridTextColumn Header="{helpers:Trans '灰度'}" Binding="{Binding GrayText}" IsReadOnly="True" Width="36"/>
                            <DataGridTextColumn Header="{helpers:Trans '偏色'}" Width="*"
                                                Binding="{Binding Bias, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBox Text="{Binding DamoText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                 FontSize="12" TextWrapping="Wrap" MinHeight="54" MaxHeight="100"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{ui:ThemeResource ControlFillColorDefaultBrush}"/>
                        <TextBlock Text="{helpers:Trans '格式: x,y,RRGGBB-偏色 | …（1080P 逻辑坐标）'}" FontSize="11"
                                   Margin="0,3,0,6" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"/>
                        <ui:Button Content="{helpers:Trans '复制'}" Command="{Binding CopyDamoCommand}"
                                   Appearance="Primary" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- ── 截图器页 ── -->
                <StackPanel Grid.Row="1" Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVis}}">
                    <ui:Button Content="{helpers:Trans '截图'}" Command="{Binding CaptureToEditorCommand}"
                               Appearance="Primary" Height="44" Margin="0,0,0,8"
                               Icon="{ui:SymbolIcon Symbol=Camera24}"/>
                    <ui:Button Content="{helpers:Trans '保存'}" Command="{Binding SaveImageCommand}"
                               Height="44" Margin="0,0,0,8"/>
                    <ui:Button Content="{helpers:Trans '编辑'}" Command="{Binding OpenEditorCommand}"
                               Height="44" Margin="0,0,0,12"/>
                    <TextBlock Text="{helpers:Trans '提示: 在左侧画面直接拖框 = 框选截图'}" FontSize="11"
                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
