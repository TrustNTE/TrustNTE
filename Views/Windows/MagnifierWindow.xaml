<Window x:Class="TrustNTE.Views.MagnifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="放大镜" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="True">
    <Border x:Name="DragBorder" CornerRadius="10" BorderThickness="1" Padding="8" Cursor="SizeAll"
            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            MouseLeftButtonDown="DragBorder_MouseDown">
        <StackPanel>
            <Grid Width="170" Height="170">
                <Image Source="{Binding ZoomImage}" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Canvas IsHitTestVisible="False">
                    <Line X1="85" Y1="70" X2="85" Y2="100" Stroke="#FF4040" StrokeThickness="1"/>
                    <Line X1="70" Y1="85" X2="100" Y2="85" Stroke="#FF4040" StrokeThickness="1"/>
                </Canvas>
            </Grid>
            <TextBlock Text="{Binding Info}" Margin="0,6,0,0" FontSize="11" FontFamily="Consolas"
                       TextAlignment="Center"
                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
        </StackPanel>
    </Border>
</Window>
