<ui:FluentWindow x:Class="TrustNTE.Views.Windows.ListConfigWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="黑白名单配置"
                 Height="560" Width="640"
                 WindowStartupLocation="CenterOwner"
                 Background="#1A1A1A">
    <Window.Resources>
        <Style x:Key="TabStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#B0FFFFFF"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#332A6B8F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文档按钮：普通 Button（绝不进 ListTab 单选组，点了不会切走模式） -->
        <Style x:Key="DocButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#B0FFFFFF"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row0: 页签 = 模式（RadioButton 组互斥）+ 文档按钮 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <RadioButton x:Name="TabWhite" Content="白名单" GroupName="ListTab"
                         Style="{StaticResource TabStyle}" Margin="0,0,8,0"
                         Checked="Tab_Changed" Unchecked="Tab_Changed"/>
            <RadioButton x:Name="TabBlack" Content="黑名单" GroupName="ListTab"
                         Style="{StaticResource TabStyle}" Margin="0,0,8,0"
                         Checked="Tab_Changed" Unchecked="Tab_Changed"/>
            <!-- 文档按钮：与主界面文档按钮同款（强调色） -->
            <ui:Button Padding="4,2" Appearance="Transparent" Cursor="Hand"
                       Click="OpenDoc_Click" ToolTip="黑白名单使用说明">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="14" Margin="0,0,4,0"
                                   Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="文档" FontSize="12"
                               Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>

        </StackPanel>

        <!-- Row1: 搜索条 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- ★ 搜索框套一层 Grid，放大镜叠在左侧；TextBox 左 Padding 让位 30px -->
            <Grid Grid.Column="0" HorizontalAlignment="Left" Width="360">
                <TextBox x:Name="SearchBox" Padding="30,5,8,5" FontSize="12"
                         VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
                <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="10,0,0,0"
                               Foreground="#80FFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="8,0,0,0">
                <RadioButton x:Name="ModeFuzzy" Content="模糊" GroupName="SearchMode" IsChecked="True"
                             Style="{StaticResource TabStyle}" Padding="8,4" FontSize="11"
                             Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeExact" Content="精准" GroupName="SearchMode"
                             Style="{StaticResource TabStyle}" Padding="8,4" FontSize="11" Margin="6,0,0,0"
                             Checked="Mode_Changed"/>
            </StackPanel>
            <TextBlock x:Name="HitLabel" Grid.Column="2" Text="" VerticalAlignment="Center"
                       Foreground="#A0FFFFFF" FontSize="12" Margin="12,0,0,0"/>
            <Button x:Name="BtnPrev" Grid.Column="3" Width="40" Height="28" Margin="10,0,6,0"
                    Click="BtnPrev_Click" ToolTip="上一个 (Shift+Enter)">
                <ui:SymbolIcon Symbol="ChevronUp24" FontSize="15"/>
            </Button>
            <Button x:Name="BtnNext" Grid.Column="4" Width="40" Height="28"
                    Click="BtnNext_Click" ToolTip="下一个 (Enter)">
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="15"/>
            </Button>
        </Grid>

        <!-- Row2: 当前模式说明 -->
        <TextBlock x:Name="DescText" Grid.Row="2" Foreground="#80FFFFFF" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- Row3: 两个完全独立的编辑区 -->
        <Grid Grid.Row="3">
            <Grid x:Name="PanelWhite">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168*"/>
                    <ColumnDefinition Width="35*"/>
                    <ColumnDefinition Width="101*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WhiteBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Microsoft YaHei" FontSize="13"
                         Background="#1E1E1E" Foreground="#DDDDDD" CaretBrush="#00FFCC"
                         BorderBrush="#33FFFFFF" Padding="8" Grid.ColumnSpan="3" TextChanged="WhiteBox_TextChanged"/>
            </Grid>
            <Grid x:Name="PanelBlack" Visibility="Collapsed">
                <TextBox x:Name="BlackBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Microsoft YaHei" FontSize="13"
                         Background="#1E1E1E" Foreground="#DDDDDD" CaretBrush="#00FFCC"
                         BorderBrush="#33FFFFFF" Padding="8"/>
            </Grid>
        </Grid>

        <!-- Row4: 底栏 -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="保存后立即生效（一行一个词条）" VerticalAlignment="Center"
                       Foreground="#80FFFFFF" FontSize="12" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="保存" Width="88" Height="32" Margin="0,0,10,0"
                        Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel" Content="取消" Width="88" Height="32"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
