<ui:FluentWindow x:Class="TrustNTE.Views.LogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:TrustNTE.Views.Controls"
                 xmlns:helpers="clr-namespace:TrustNTE.Helpers"
                 Title="{helpers:Trans 'TrustNTE - 运行日志'}"
                 Height="500" Width="800"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Background="#1A1A1A">

    <Window.Resources>
        <!-- 级别过滤 chip（小药丸样式） -->
        <Style x:Key="ChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#B0FFFFFF"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#332A6B8F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开发者模式开关：未选中透明度对齐 ui:Button 原生令牌；选中 = 品牌青 #00FFCC -->
        <!-- 想改纯蓝：把两处 #00FFCC 换成 #0078D4 即可 -->
        <Style x:Key="DevToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00FFCC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00FFCC"/>
                                <Setter Property="Foreground" Value="#121212"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{helpers:Trans 'TrustNTE - 运行日志'}"
                     Background="Transparent">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/titlelogo.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,0,16,10">
            <!-- 左：级别过滤 chips -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <RadioButton x:Name="ChipAll"   Content="{helpers:Trans '全部'}"  GroupName="LogLvl" Tag="Debug"     IsChecked="True" Style="{StaticResource ChipStyle}" Margin="0,0,6,0" Checked="Chip_Checked"/>
                <RadioButton x:Name="ChipInfo"  Content="INFO"    GroupName="LogLvl" Tag="Info"      Style="{StaticResource ChipStyle}" Margin="0,0,6,0" Checked="Chip_Checked"/>
                <RadioButton x:Name="ChipWarn"  Content="WARN"    GroupName="LogLvl" Tag="Warn"      Style="{StaticResource ChipStyle}" Margin="0,0,6,0" Checked="Chip_Checked"/>
                <RadioButton x:Name="ChipError" Content="ERROR"   GroupName="LogLvl" Tag="Error"     Style="{StaticResource ChipStyle}" Margin="0,0,6,0" Checked="Chip_Checked"/>
                <!-- ★ 新增：DEBUG专用chip（Tag=DebugOnly → 只看DEBUG级条目） -->
                <RadioButton x:Name="ChipDebug" Content="DEBUG"   GroupName="LogLvl" Tag="DebugOnly" Style="{StaticResource ChipStyle}" Checked="Chip_Checked"/>
            </StackPanel>

            <!-- 右：开发者模式（虫子图标） + 复制 + 清空 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton x:Name="DevToggle"
                              Style="{StaticResource DevToggleStyle}"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Checked="DevToggle_Changed"
                              Unchecked="DevToggle_Changed">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Bug24" FontSize="16" Margin="0,0,7,0"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"/>
                        <TextBlock Text="{helpers:Trans '开发者模式'}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </ToggleButton>

                <ui:Button Content="{Binding CopyButtonText}" Click="CopyButton_Click" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,10,0"/>
                <ui:Button Content="{helpers:Trans '清空界面'}" Click="ClearButton_Click" Icon="{ui:SymbolIcon Delete24}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#1E1E1E" Margin="16,0,16,16" CornerRadius="8" Padding="8">
            <controls:LogConsoleControl x:Name="MainConsole" Title="{helpers:Trans '实时控制台输出'}" />
        </Border>
    </Grid>
</ui:FluentWindow>
