<Window x:Class="TrustNTE.Update.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrustNTE · 更新程序" Height="430" Width="480"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" AllowsTransparency="True" BorderBrush="#3C3C3C" BorderThickness="1"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- 主按钮样式：圆角 + 悬停反馈 -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#58A6FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#3A3D42"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ============ 自绘标题栏 ============ -->
        <Grid VerticalAlignment="Top" Height="40" Background="#252526" Margin="1,1,1,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0" VerticalAlignment="Center">
                <!--【改动】png → ico，资源确定存在 -->
                <Image Source="/Assets/titlelogo.ico" Width="20" Height="20" Margin="0,0,8,0"/>
                <TextBlock Text="TrustNTE · 更新程序" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="CloseBtn" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="12"
                    Cursor="Hand" Click="CloseBtn_Click" Margin="0,0,15,0" Width="30" Height="30"/>
        </Grid>

        <Grid Margin="20,50,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 品牌区【改动：加了中央 LOGO】 ============ -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,16">
                <Image Source="/Assets/titlelogo.ico" Width="72" Height="72" Margin="0,0,0,12"/>
                <TextBlock Text="TrustNTE" Foreground="White" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
                <TextBlock Text="让异环解放双手" Foreground="LightGray" FontSize="14" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- 状态文字（准备中 / 下载中 / 校验中） -->
                <TextBlock x:Name="StatusText" Text="正在准备环境..." Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>

                <!-- 源选择（保留原有，未动） -->
                <StackPanel x:Name="SourcePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="选择安装源：" Foreground="Gray" Margin="0,0,0,10"/>
                    <RadioButton x:Name="RbGithub" Content="GitHub (开源渠道，从github更细如果无法更新进群下载最新版本)" Foreground="LightGray" IsChecked="True" GroupName="Sources" Margin="0,5,0,5" Cursor="Hand"/>
                    <RadioButton x:Name="RbTencent" Content="腾讯云 COS (国内极速下载)" Foreground="LightGray" GroupName="Sources" Margin="0,5,0,5" Cursor="Hand"/>
                </StackPanel>

                <!-- ============ 完成态面板【新增】 ============ -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✓" Foreground="#4EC9B0" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="您已更新完毕" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock x:Name="DoneVersionText" Text="当前已是最新版本" Foreground="Gray" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="BtnLaunch" Content="启动 TrustNTE" Width="140" Height="36"
                                Style="{StaticResource PrimaryBtn}" Click="BtnLaunch_Click"/>
                        <Button x:Name="BtnExit" Content="退出" Width="90" Height="36" Margin="12,0,0,0"
                                Style="{StaticResource GhostBtn}" Click="BtnExit_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 进度条 -->
                <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                             Foreground="#58A6FF" Background="#323232" BorderThickness="0"
                             VerticalAlignment="Bottom" Margin="0,0,0,10" Visibility="Collapsed"/>
            </Grid>

            <!-- 底部主按钮（下载中/完成态时由代码隐藏，解决"灰色更新按钮挂着"的问题） -->
            <Button x:Name="ActionBtn" Content="更 新" Grid.Row="2" Width="120" Height="36"
                    HorizontalAlignment="Right" Style="{StaticResource PrimaryBtn}" Click="ActionBtn_Click"/>
        </Grid>
    </Grid>
</Window>
